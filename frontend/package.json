    "@trpc/server": "^11.6.0",
    "next": "^16.0.0",
    "next-auth": "5.0.0-beta.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.9.1",
